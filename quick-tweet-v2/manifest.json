{
  "manifest_version": 3,
  "name": "Quick Tweet V2",
  "version": "2.0.0",
  "description": "Tweet current page to X (Twitter) quickly",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Tweet this page",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
